{
    "length": 1.0,
    "youngModulus": 1e6,
    "forceField": "LinearSmallStrainFEMForceField",
    "linearSolver": {
        "type": "PCGLinearSolver",
        "parameters": {
            "template": "GraphScattered",
            "tolerance": 1e-14,
            "iterations": 200,
            "preconditioner": "@precond"
        },
        "preconditioner": "SSORPreconditioner"
    },
    "reference": {
        "nx": 20,
        "nu": 0.3
    },
    "convergence": {
        "nu_values": [0.3],
        "nx_values": {
            "sinusoidal": [
                  8, 12, 16, 20, 24, 28,
                32, 36, 40, 44, 48, 52, 56, 60
            ]
        }
    }
}

{
  "geometry":    { "type": "Beam2D", "length": 1.0, "width": 1.0 },
  "element":     "quad",
  "quadratureDegree": 3,
  "sourceQuadratureDegree": 3,
  "material":    { "youngModulus": 1e6, "poissonRatio": 0.3 },
  "forceField":  "LinearSmallStrainFEMForceField",
  "solvers": {
    "integration":  { "type": "StaticSolver" },
    "newton":       { "type": "NewtonRaphsonSolver", "maxNbIterationsNewton": 10, "absoluteResidualStoppingThreshold": 1e-10 },
    "linearSolver": { "type": "SparseLDLSolver", "template": "CompressedRowSparseMatrixd" }
  },
  "mesh":        { "sizes": [[3, 3], [5, 5], [9, 9], [17, 17], [33, 33], [65, 65]] },
  "asymptoticTolerance": 0.10,
  "function":    "quadratic"
}

{
  "geometry":    { "type": "Beam3D", "length": 1.0, "width": 1.0, "height": 1.0 },
  "element":     "tet",
  "quadratureDegree": 2,
  "sourceQuadratureDegree": 2,
  "material":    { "youngModulus": 1e6, "poissonRatio": 0.3 },
  "forceField":  "LinearSmallStrainFEMForceField",
  "solvers": {
    "integration":  { "type": "StaticSolver" },
    "newton":       { "type": "NewtonRaphsonSolver", "maxNbIterationsNewton": 1,
                      "relativeInitialStoppingThreshold": 1e-6,
                      "relativeSuccessiveStoppingThreshold": 0,
                      "absoluteResidualStoppingThreshold": 0 },
    "linearSolver": {
      "type": "PCGLinearSolver", "iterations": 1000, "tolerance": 1e-12,
      "system": { "type": "PreconditionedMatrixFreeSystem" },
      "preconditioner": {
        "type": "SSORPreconditioner",
        "system": { "type": "MatrixLinearSystem", "template": "CompressedRowSparseMatrixd" }
      }
    }
  },
  "mesh":        { "cells": [3, 3, 3], "levels": 4, "refinementRatio": 2 },
  "asymptoticTolerance": 0.10,
  "function":    "trigonometric"
}
